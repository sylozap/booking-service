{
  "uid": "barber-async",
  "title": "Async",
  "description": "Outbox, consumer lag, retries and dead letters, the notification queue and the schedulers: why a notification did not arrive.",
  "tags": [
    "barber",
    "async"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
