    {
      "type": "timeseries",
      "title": "Database pool in use",
      "description": "Share of pool size plus overflow that is checked out. Near 1 for minutes: requests wait for a connection and will fail on the pool timeout -- raise the pool or find what holds connections, a network call inside a transaction first of all.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
