          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (channel) (rate(notifications_sent_total{result=\"sent\"}[$__rate_interval])) / sum by (channel) (rate(notifications_sent_total[$__rate_interval]))",
