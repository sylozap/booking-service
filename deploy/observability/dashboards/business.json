    {
      "type": "timeseries",
      "title": "Conflicts per attempt",
      "description": "The key panel. A lost race means a client picked a slot availability still showed as free. Growth here says the availability cache lives too long (AVAILABILITY_CACHE_TTL_SECONDS), or invalidation after a booking stopped working.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
