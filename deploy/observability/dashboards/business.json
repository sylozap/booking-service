            "uid": "prometheus"
          },
          "expr": "sum(rate(booking_conflicts_total{salon=~\"$salon\"}[$__rate_interval])) / (sum(rate(bookings_created_total{salon=~\"$salon\"}[$__rate_interval])) + sum(rate(booking_conflicts_total{salon=~\"$salon\"}[$__rate_interval])))",
          "legendFormat": "conflicts per attempt"
        }
