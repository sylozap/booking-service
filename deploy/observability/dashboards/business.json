      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum by (status) (rate(bookings_created_total{salon=~\"$salon\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
