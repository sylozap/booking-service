# Configuration of a service. Copy to .env for local development.
# Every variable is read by pydantic-settings; there is no other source of
# configuration. Variables without a default are mandatory: a service that
# cannot see one fails at startup instead of running half-configured.

# --- identity ---------------------------------------------------------------

# Name of the service. Appears in every log record, metric and trace.
SERVICE_NAME=booking
# Deployment environment: local | test | dev | prod
ENVIRONMENT=local
# Threshold of the root logger: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------

# DSN of the database owned by this service. The scheme must be
# postgresql+asyncpg. Each service has its own database and its own role with
# rights on that database only.
DATABASE_DSN=postgresql+asyncpg://booking:booking@localhost:5432/booking
# Size of the connection pool held by one process.
DATABASE_POOL_SIZE=10
# Extra connections allowed above the pool size during a burst.
DATABASE_MAX_OVERFLOW=5
# How long a request waits for a free connection before failing.
DATABASE_POOL_TIMEOUT_SECONDS=5.0
# Log every SQL statement. Development only, never in prod.
DATABASE_ECHO=false

# Migrations are applied per service by scripts/migrate.sh, and each service has
# a role of its own, so each one has a DSN of its own. Used by that script only;
# a running service reads DATABASE_DSN.
AUTH_DATABASE_DSN=postgresql+asyncpg://auth:auth@localhost:5432/auth
CATALOG_DATABASE_DSN=postgresql+asyncpg://catalog:catalog@localhost:5432/catalog
BOOKING_DATABASE_DSN=postgresql+asyncpg://booking:booking@localhost:5432/booking
NOTIFICATION_DATABASE_DSN=postgresql+asyncpg://notification:notification@localhost:5432/notification

# --- Redis ------------------------------------------------------------------

# Cache and rate limiter. Never an arbiter of slot availability (ADR-0012).
REDIS_DSN=redis://localhost:6379/0

# --- Kafka ------------------------------------------------------------------

# Comma separated list of brokers.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenTelemetry ----------------------------------------------------------

# Tracing works idle while the exporter is off; stages 0 to 6 run without it.
OTLP_ENABLED=false
# OTLP endpoint of the collector, for example http://tempo:4317
OTLP_ENDPOINT=

# --- probes -----------------------------------------------------------------

# Shared deadline of all readiness checks.
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
