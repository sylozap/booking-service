# Configuration of a service. Copy to .env for local development.
# Every variable is read by pydantic-settings; there is no other source of
# configuration. Variables without a default are mandatory: a service that
# cannot see one fails at startup instead of running half-configured.

# --- identity ---------------------------------------------------------------

# Name of the service. Appears in every log record, metric and trace.
SERVICE_NAME=booking
# Deployment environment: local | test | dev | prod
ENVIRONMENT=local
# Threshold of the root logger: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------

# DSN of the database owned by this service. The scheme must be
# postgresql+asyncpg. Each service has its own database and its own role with
# rights on that database only.
DATABASE_DSN=postgresql+asyncpg://booking:booking@localhost:5432/booking
# Size of the connection pool held by one process.
DATABASE_POOL_SIZE=10
# Extra connections allowed above the pool size during a burst.
DATABASE_MAX_OVERFLOW=5
# How long a request waits for a free connection before failing.
DATABASE_POOL_TIMEOUT_SECONDS=5.0
# Log every SQL statement. Development only, never in prod.
DATABASE_ECHO=false

# Migrations are applied per service by scripts/migrate.sh, and each service has
# a role of its own, so each one has a DSN of its own. Used by that script only;
# a running service reads DATABASE_DSN.
AUTH_DATABASE_DSN=postgresql+asyncpg://auth:auth@localhost:5432/auth
CATALOG_DATABASE_DSN=postgresql+asyncpg://catalog:catalog@localhost:5432/catalog
BOOKING_DATABASE_DSN=postgresql+asyncpg://booking:booking@localhost:5432/booking
NOTIFICATION_DATABASE_DSN=postgresql+asyncpg://notification:notification@localhost:5432/notification

# --- Redis ------------------------------------------------------------------

# Cache and rate limiter. Never an arbiter of slot availability (ADR-0012).
REDIS_DSN=redis://localhost:6379/0

# --- Kafka ------------------------------------------------------------------

# Comma separated list of brokers.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenTelemetry ----------------------------------------------------------

# Tracing works idle while the exporter is off; stages 0 to 6 run without it.
OTLP_ENABLED=false
# OTLP endpoint of the collector, for example http://tempo:4317
OTLP_ENDPOINT=

# --- auth: passwords --------------------------------------------------------

# Cost of one argon2id hash. Defaults follow the second recommended option of
# RFC 9106: 64 MiB of memory and three passes. Raising them does not invalidate
# the hashes already stored -- every hash carries its own parameters.
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_PARALLELISM=4
PASSWORD_ARGON2_HASH_LENGTH=32
PASSWORD_ARGON2_SALT_LENGTH=16
# Shortest password the service accepts. Length carries most of the strength.
PASSWORD_MIN_LENGTH=10

# --- auth: email confirmation -----------------------------------------------

# How long the one-time confirmation link stays valid.
EMAIL_CONFIRMATION_TTL_HOURS=24
# Where the link points: the page that reads the token out of the query string
# and posts it to /api/v1/auth/confirm-email.
EMAIL_CONFIRMATION_URL=http://localhost:8080/confirm-email

# --- auth: signing keys -----------------------------------------------------

# The RS256 private key access tokens are signed with. Set exactly one of the
# two variables below; the service refuses to start with both or with neither,
# because "which key signs the tokens" must never depend on the order fields
# happen to be read in.
#
# Generate a key with:  python scripts/gen_keys.py --env
# The script prints the JWT_PRIVATE_KEY line and the kid the key will have.
#
# A path is how the cluster does it: the key is a Secret mounted as a file, so
# rotating it is replacing the file and restarting the pods.
JWT_PRIVATE_KEY_PATH=
# The PEM itself, on one line with \n escapes. Convenient for compose and a
# local .env. Never commit a real value: .env is not tracked, and
# scripts/check-secrets.sh fails the build if a key reaches git.
JWT_PRIVATE_KEY=

# The "iss" claim of every access token, and what verifiers check it against.
# Configuration and not a constant, so a token minted in dev is not accepted
# in prod.
JWT_ISSUER=https://barber.local/auth

# --- auth: token lifetimes --------------------------------------------------

# How long an access token is good for. Short on purpose: it is verified
# locally against a public key, so nothing can withdraw it early (ADR-0010),
# and the TTL is what bounds the damage instead.
ACCESS_TOKEN_TTL_MINUTES=15
# How long a session survives without a login. Every use rotates the token.
REFRESH_TOKEN_TTL_DAYS=30

# --- probes -----------------------------------------------------------------

# Shared deadline of all readiness checks.
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
