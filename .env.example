# Configuration of a service. Copy to .env for local development.
# Every variable is read by pydantic-settings; there is no other source of
# configuration. Variables without a default are mandatory: a service that
# cannot see one fails at startup instead of running half-configured.

# --- identity ---------------------------------------------------------------

# Name of the service. Appears in every log record, metric and trace.
SERVICE_NAME=booking
# Deployment environment: local | test | dev | prod
ENVIRONMENT=local
# Threshold of the root logger: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------

# DSN of the database owned by this service. The scheme must be
# postgresql+asyncpg. Each service has its own database and its own role with
# rights on that database only.
DATABASE_DSN=postgresql+asyncpg://booking:booking@localhost:5432/booking
# Size of the connection pool held by one process.
DATABASE_POOL_SIZE=10
# Extra connections allowed above the pool size during a burst.
DATABASE_MAX_OVERFLOW=5
# How long a request waits for a free connection before failing.
DATABASE_POOL_TIMEOUT_SECONDS=5.0
# Log every SQL statement. Development only, never in prod.
DATABASE_ECHO=false

# Migrations are applied per service by scripts/migrate.sh, and each service has
# a role of its own, so each one has a DSN of its own. Used by that script only;
# a running service reads DATABASE_DSN.
AUTH_DATABASE_DSN=postgresql+asyncpg://auth:auth@localhost:5432/auth
CATALOG_DATABASE_DSN=postgresql+asyncpg://catalog:catalog@localhost:5432/catalog
BOOKING_DATABASE_DSN=postgresql+asyncpg://booking:booking@localhost:5432/booking
NOTIFICATION_DATABASE_DSN=postgresql+asyncpg://notification:notification@localhost:5432/notification

# --- Redis ------------------------------------------------------------------

# Cache and rate limiter. Never an arbiter of slot availability.
REDIS_DSN=redis://localhost:6379/0

# --- cache ------------------------------------------------------------------

# The cache only makes reads cheaper, so running without it is supported. Off
# means every read goes to the database, with identical answers.
CACHE_ENABLED=true
# How long a cached read survives. Also the ceiling on the one staleness window
# a cache-aside scheme cannot close: a reader that started before a write can
# store what it read after the invalidation.
CACHE_TTL_SECONDS=300
# Deadline on one Redis command. A cache that has gone slow is worse than one
# that is gone -- without this, the read it exists to accelerate waits on it.
CACHE_TIMEOUT_SECONDS=0.2

# --- Kafka ------------------------------------------------------------------

# Comma separated list of brokers.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenTelemetry ----------------------------------------------------------

# Tracing stays idle while the exporter is off.
OTLP_ENABLED=false
# OTLP endpoint of the collector, for example http://tempo:4317
OTLP_ENDPOINT=

# --- auth: passwords --------------------------------------------------------

# Cost of one argon2id hash. Defaults follow the second recommended option of
# RFC 9106: 64 MiB of memory and three passes. Raising them does not invalidate
# the hashes already stored -- every hash carries its own parameters.
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_PARALLELISM=4
PASSWORD_ARGON2_HASH_LENGTH=32
PASSWORD_ARGON2_SALT_LENGTH=16
# Shortest password the service accepts. Length carries most of the strength.
PASSWORD_MIN_LENGTH=10

# --- auth: email confirmation -----------------------------------------------

# How long the one-time confirmation link stays valid. The letter itself is
# sent by notification, see EMAIL_CONFIRMATION_URL below.
EMAIL_CONFIRMATION_TTL_HOURS=24

# --- auth: signing keys -----------------------------------------------------

# The RS256 private key access tokens are signed with. Set exactly one of the
# two variables below; the service refuses to start with both or with neither,
# because "which key signs the tokens" must never depend on the order fields
# happen to be read in.
#
# Generate a key with:  python scripts/gen_keys.py --env
# The script prints the JWT_PRIVATE_KEY line and the kid the key will have.
#
# A path is how the cluster does it: the key is a Secret mounted as a file, so
# rotating it is replacing the file and restarting the pods.
JWT_PRIVATE_KEY_PATH=
# The PEM itself, on one line with \n escapes. Convenient for compose and a
# local .env. Never commit a real value: .env is not tracked, and
# scripts/check-secrets.sh fails the build if a key reaches git.
JWT_PRIVATE_KEY=

# --- auth: token lifetimes --------------------------------------------------

# How long an access token is good for. Short because it cannot be revoked
# before it expires.
ACCESS_TOKEN_TTL_MINUTES=15
# How long a session survives without a login. Every use rotates the token.
REFRESH_TOKEN_TTL_DAYS=30

# --- auth: background cleanup ------------------------------------------------

# How often the worker prunes, and how much it removes per pass. Batched
# because one statement deleting a month of rows holds a long transaction on a
# large table and blocks the writes the service is there to serve.
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_BATCH_SIZE=1000

# How long a row stays after it stopped meaning anything. Rows are deleted by
# expiry and never by state: a refresh token that is revoked but not yet
# expired is what makes a stolen token detectable as reuse, and a spent email
# confirmation is what makes a second click "already used" rather than "never
# existed". The windows below are added on top of the expiry, never instead
# of it, and leave something to read during an incident.
CLEANUP_TOKEN_RETENTION_DAYS=7
CLEANUP_CONFIRMATION_RETENTION_DAYS=7
CLEANUP_PROCESSED_EVENT_RETENTION_DAYS=7

# --- auth: machine to machine clients ----------------------------------------

# Services that may ask auth for a token of their own, as JSON. Registered at
# startup: a client seeded by a migration would carry its secret hash in git,
# and rotating it would become a schema change. Only the hash reaches the
# database, argon2, exactly like a password.
#
# Empty is valid -- a deployment with no internal callers refuses everything.
# SERVICE_CLIENTS={"booking": {"secret": "change-me", "scopes": ["catalog:read"]}}
SERVICE_CLIENTS={}

# How long a service token is good for. Shorter than a user token: a service
# asks for one per burst of calls rather than per session, so a short life
# costs it little and bounds the window a leaked one is useful for.
SERVICE_TOKEN_TTL_MINUTES=5

# --- verifying access tokens (every service) ---------------------------------

# Every service verifies the tokens it receives itself, so these apply to all
# five, including auth, which uses the keys it already holds.

# The expected "iss" claim. auth writes it, everyone checks it, so it is one
# setting read from both sides: a token minted in dev is then not accepted
# in prod.
JWT_ISSUER=https://barber.local/auth

# Base URL of auth, where /.well-known/jwks.json is served. Mandatory for every
# service except auth, which does not use it.
JWKS_URL=http://auth:8001
# How long fetched keys are kept before a refresh.
JWKS_CACHE_TTL_SECONDS=300
# Floor on how often a token naming an unknown key may force a refresh. This is
# also the longest a key rotation goes unnoticed: a burst of forged headers
# costs one request to auth per interval, not one per token.
JWKS_REFRESH_MIN_INTERVAL_SECONDS=10
# Tolerance for clock skew between pods when checking exp and iat. Not a grace
# period -- an access token that cannot be revoked is only acceptable because
# it expires when it says it does.
JWT_LEEWAY_SECONDS=5

# --- booking: calls to other services ----------------------------------------

# Base URLs of the services booking calls. No defaults: an address that quietly
# points at localhost is a misconfiguration found in production.
CATALOG_URL=http://catalog:8002
AUTH_URL=http://auth:8001
# The client credentials booking exchanges for a service token in auth. They
# must match the "booking" entry of SERVICE_CLIENTS on the auth side.
SERVICE_CLIENT_ID=booking
SERVICE_CLIENT_SECRET=change-me

# How long the answer to a repeated POST /api/v1/bookings is repeated instead
# of being carried out again. A key older than this is free to be reused.
IDEMPOTENCY_TTL_HOURS=24

# How many hours before the appointment the client is reminded. Written into
# the booking when it is created and recomputed on every reschedule.
REMINDER_LEAD_HOURS=4
# How often the reminder scheduler looks for due reminders, and how many
# bookings one pass takes; a full batch is followed by the next one at once.
REMINDER_SCHEDULER_INTERVAL_SECONDS=60.0
REMINDER_SCHEDULER_BATCH_SIZE=100

# How long a day of availability stays cached. Far shorter than the catalog
# cache: it changes whenever anyone books, and a minute is the staleness a
# client can be shown. The cache is never the arbiter -- the database is.
AVAILABILITY_CACHE_TTL_SECONDS=60

# --- notification: delivery ---------------------------------------------------

# How often the delivery worker looks for due messages when it found none, and
# how many it takes per pass.
DELIVERY_INTERVAL_SECONDS=1.0
DELIVERY_BATCH_SIZE=20
# How long a message taken for sending is left alone; a worker that dies
# mid-send leaves it to be taken again after this.
DELIVERY_LEASE_SECONDS=60
# Attempts on a temporary failure (a timeout, a 5xx, a rate limit) before a
# message is given up on, and the first pause between them; each next doubles.
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_DELAY_SECONDS=30.0

# Where the link in the confirmation letter points: the page that reads the
# token out of the query string and posts it to /api/v1/auth/confirm-email.
EMAIL_CONFIRMATION_URL=http://localhost:8080/confirm-email

# --- notification: telegram ---------------------------------------------------

# The bot notifications are sent from, from @BotFather. Optional: without a
# token the telegram channel is written to the log instead and linking a chat
# answers 422 channel_unavailable, but the service starts and works. The token
# is a secret -- in the cluster it comes from a Secret, never from git.
TELEGRAM_BOT_TOKEN=
# The bot's name without the @, for the t.me link a user opens to link a chat.
TELEGRAM_BOT_USERNAME=
# Timeout of one Bot API call, and how long one long poll waits for messages.
TELEGRAM_TIMEOUT_SECONDS=5.0
TELEGRAM_POLL_TIMEOUT_SECONDS=25
# How long a code for linking a chat stays valid.
TELEGRAM_LINK_CODE_TTL_MINUTES=15

# --- api-gateway: the services behind it --------------------------------------

# Base URLs of the four services the gateway forwards to. AUTH_URL and
# CATALOG_URL are the variables booking reads above; the gateway reads them too,
# plus the two below. No defaults, for the same reason.
BOOKING_URL=http://booking:8003
NOTIFICATION_URL=http://notification:8004

# Deadlines of one forwarded request. The read deadline is per chunk of the
# answer, not for the whole answer: a large one keeps streaming as long as it
# keeps moving. Exceeding it answers 504 upstream_timeout; a service that does
# not accept the connection answers 503 upstream_unavailable.
PROXY_CONNECT_TIMEOUT_SECONDS=1.0
PROXY_READ_TIMEOUT_SECONDS=10.0
PROXY_WRITE_TIMEOUT_SECONDS=10.0
PROXY_POOL_TIMEOUT_SECONDS=1.0

# --- api-gateway: rate limiting ---------------------------------------------

# Sliding window counters in Redis (REDIS_DSN). A strict limit counts on top of
# the general one. Without Redis the limiter lets everything through: the stand
# gets slower, never closed.
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_BOOKING_CREATE_PER_MINUTE=5
# POST /api/v1/auth/register, the one request that sends a confirmation letter.
RATE_LIMIT_REGISTRATION_PER_HOUR=3
# Deadline of one call to Redis; past it the request is let through.
RATE_LIMIT_TIMEOUT_SECONDS=0.2
# Proxies in front of the gateway whose X-Forwarded-For entries are believed:
# 0 when clients connect directly, 1 behind the Ingress of the cluster. More
# than there really are lets a client pick the address it is limited by.
TRUSTED_PROXY_HOPS=0

# --- probes -----------------------------------------------------------------

# Shared deadline of all readiness checks.
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
